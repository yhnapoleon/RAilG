# 复制为 .env 后填入。ragbot 启动时自动加载。
#
# 三个 provider 可以用同一个 key(同一家服务商),也可以分开。
# 只填 RAGBOT_API_KEY 时,三个 provider 都用它。

RAGBOT_API_KEY=sk-xxxxxxxxxxxxxxxx

# 需要分开时再填这三个(留空则回退到 RAGBOT_API_KEY)
# RAGBOT_EMBEDDING_API_KEY=
# RAGBOT_RERANK_API_KEY=
# RAGBOT_LLM_API_KEY=

# 启用登录时必填
# RAGBOT_ADMIN_PASSWORD=
# RAGBOT_JWT_SECRET=

# ---------------------------------------------------------------
# 换服务商:改 config.yaml 里的 base_url + model 即可,代码不用动。
#
# 硅基流动(默认,三样齐全)
#   base_url: https://api.siliconflow.cn/v1
#   embedding: BAAI/bge-m3          rerank: BAAI/bge-reranker-v2-m3
#   llm:       Qwen/Qwen3-8B
#
# 阿里云百炼
#   base_url: https://dashscope.aliyuncs.com/compatible-mode/v1
#   embedding: text-embedding-v3 (dims 1024)   llm: qwen-plus
#   注:rerank 不走 OpenAI 兼容端点,需置 rerank.enabled=false 或自行适配
#
# DeepSeek(只有 LLM,embedding/rerank 需另找)
#   base_url: https://api.deepseek.com/v1      llm: deepseek-chat
#
# 本地 Ollama(零成本,慢)
#   base_url: http://localhost:11434/v1
#   embedding: bge-m3               llm: qwen3:8b
#   注:Ollama 无 rerank,置 rerank.enabled=false
# ---------------------------------------------------------------
